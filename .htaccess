# ============================================================================
# RAM Martial Arts — configuración de Apache (Hostinger)
# Va en la raíz de public_html, junto a index.html
# ============================================================================

# ---------------------------------------------------------------- índice
DirectoryIndex index.html

# Sin listado de carpetas: si falta un index, no mostrar los archivos
Options -Indexes

# ------------------------------------------------- HTTPS y www → sin www
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS (Hostinger pasa el protocolo original en esta variable)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Unificar en el dominio sin www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# --------------------------------------------- archivos que no se publican
# En Vercel esto lo hacía .vercelignore. Acá se sube toda la carpeta, así que
# hay que bloquearlos explícitamente.
<FilesMatch "\.(dc\.html|md|sql|mjs)$">
  Require all denied
</FilesMatch>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

RedirectMatch 404 ^/(supabase|scripts)(/|$)
RedirectMatch 404 ^/\.git(/|$)

# ----------------------------------------------------- cabeceras de seguridad
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # El panel no debe quedar indexado ni cacheado
  <FilesMatch "^(config\.js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/admin#">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

# ------------------------------------------------------------------ caché
<IfModule mod_expires.c>
  ExpiresActive On

  # Las fotos no cambian de nombre, pero se reemplazan poco
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"

  # El HTML siempre fresco: es lo que trae los cambios
  ExpiresByType text/html                "access plus 0 seconds"

  ExpiresByType text/css                 "access plus 1 week"
  ExpiresByType application/javascript   "access plus 1 day"
</IfModule>

# -------------------------------------------------------------- compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------- tipos MIME
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType image/webp             .webp
  AddType font/woff2             .woff2
</IfModule>
